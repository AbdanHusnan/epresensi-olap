<?xml version='1.0' encoding='utf-8'?>
<pipeline>
  <info>
    <name>source_raw_user</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Full refresh source public.m_user to raw.raw_user; business values are copied unchanged.</description>
    <pipeline_type>Normal</pipeline_type>
    <parameters />
  </info>
  <order>
    <hop>
      <from>Baca source m_user</from>
      <to>Tulis raw user</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Baca source m_user</name>
    <type>TableInput</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>source_e2e_restore</connection>
    <sql>SELECT src.id,src.pegawai_id,CURRENT_TIMESTAMP AS extracted_at,'SOURCE_DASHBOARD_20261030'::text AS pipeline_run_id FROM public.m_user src JOIN test_source_dashboard_20261030.cohort c ON c.uid=src.id</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <GUI>
      <xloc>160</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Tulis raw user</name>
    <type>TableOutput</type>
    <description>Replace this raw snapshot only after the source stream starts successfully.</description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <commit>10000</commit>
    <connection>source_e2e_stage</connection>
    <fields />
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>N</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>N</specify_fields>
    <schema>raw</schema>
    <table>raw_user</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes />
    <GUI>
      <xloc>480</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>