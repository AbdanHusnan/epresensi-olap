<?xml version='1.0' encoding='utf-8'?>
<pipeline>
  <info>
    <name>raw_departemen</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Full refresh source public.m_departemen to raw.raw_departemen; business values are copied unchanged.</description>
    <pipeline_type>Normal</pipeline_type>
    <parameters />
  </info>
  <order>
    <hop>
      <from>Baca source m_departemen</from>
      <to>Tulis raw departemen</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Baca source m_departemen</name>
    <type>TableInput</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>gradual_oct30_source</connection>
    <sql>SELECT src.*,CURRENT_TIMESTAMP AS extracted_at,'GRADUAL_20261030_BATCH1'::text AS pipeline_run_id FROM (SELECT d.* FROM public.m_departemen d) src</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <GUI>
      <xloc>160</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Tulis raw departemen</name>
    <type>TableOutput</type>
    <description>Replace this raw snapshot only after the source stream starts successfully.</description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <commit>10000</commit>
    <connection>gradual_oct30_stage</connection>
    <fields />
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>N</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>N</specify_fields>
    <schema>raw</schema>
    <table>raw_departemen</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes />
    <GUI>
      <xloc>480</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>