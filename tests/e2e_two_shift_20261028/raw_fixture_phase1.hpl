<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>raw_fixture_phase1</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Append only recorded fixture event IDs. No truncation and no historical extraction.</description>
    <pipeline_type>Normal</pipeline_type>
    <parameters />
  </info>
  <order>
    <hop>
      <from>Baca source t_checkinout</from>
      <to>Tulis raw checkinout</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Baca source t_checkinout</name>
    <type>TableInput</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>e2e_restore_20261028</connection>
    <sql>SELECT src.*,CURRENT_TIMESTAMP AS extracted_at,'E2E_CURATED_TWO_SHIFT_20261028_PHASE1'::text AS pipeline_run_id FROM public.t_checkinout src JOIN test_curated_v2_20261028.events f ON f.event_id=src.id WHERE src.id IN(171377675)</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <GUI>
      <xloc>160</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Tulis raw checkinout</name>
    <type>TableOutput</type>
    <description>Append only new fixture IDs; raw backfill is preserved.</description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <commit>10000</commit>
    <connection>e2e_raw_20261028</connection>
    <fields />
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>N</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>N</specify_fields>
    <schema>raw</schema>
    <table>raw_checkinout</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes />
    <GUI>
      <xloc>480</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>