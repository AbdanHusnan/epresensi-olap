<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>raw_jenis_ijin</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Full refresh source public.m_jenis_ijin to raw.raw_jenis_ijin; business values are copied unchanged.</description>
    <pipeline_type>Normal</pipeline_type>
    <parameters />
  </info>
  <order>
    <hop>
      <from>Baca source m_jenis_ijin</from>
      <to>Tulis raw jenis_ijin</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Baca source m_jenis_ijin</name>
    <type>TableInput</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>presensi_source</connection>
    <sql>SELECT src.*, CURRENT_TIMESTAMP AS extracted_at, 'hop_full_refresh'::text AS pipeline_run_id FROM public.m_jenis_ijin AS src</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <GUI><xloc>160</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <name>Tulis raw jenis_ijin</name>
    <type>TableOutput</type>
    <description>Replace this raw snapshot only after the source stream starts successfully.</description>
    <distribute>Y</distribute>
    <copies>1</copies>
    <commit>10000</commit>
    <connection>presensi_staging</connection>
    <fields></fields>
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>N</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>N</specify_fields>
    <schema>raw</schema>
    <table>raw_jenis_ijin</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>Y</truncate>
    <use_batch>Y</use_batch>
    <attributes />
    <GUI><xloc>480</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>
