# Local development preview only. Production requires SSO integration.
APP_ORIGIN=http://127.0.0.1:3002
APP_LOCALHOST_ORIGIN=http://localhost:3002
# Optional Windows SSH tunnel fallback when ports 3002/8090 are restricted.
APP_TUNNEL_ORIGIN=http://127.0.0.1:13002
SUPERSET_TUNNEL_URL=http://127.0.0.1:18090
DASHBOARD_LOCAL_PREVIEW=false
# URL reachable from the browser; use SSH tunnels for remote access.
SUPERSET_URL=http://127.0.0.1:8090
# Optional separate server-to-server URL.
SUPERSET_INTERNAL_URL=http://127.0.0.1:8090
# Dedicated service account with can_grant_guest_token on SecurityRestApi.
# Never use admin credentials or NEXT_PUBLIC_* variables for secrets.
SUPERSET_SERVICE_USERNAME=
SUPERSET_SERVICE_PASSWORD=
# Embedded UUIDs from Dashboard > Embed (not numeric IDs or slugs).
SUPERSET_OVERVIEW_ID=
SUPERSET_ATTENDANCE_ID=
SUPERSET_DEPARTMENTS_ID=
SUPERSET_LATENESS_ID=
