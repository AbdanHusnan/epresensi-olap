[Unit]
Description=OLAP incremental attendance and leave ETL

[Service]
Type=oneshot
WorkingDirectory=/home/piramida/OLAP
EnvironmentFile=-%h/.config/olap/incremental.env
ExecStart=/home/piramida/OLAP/.venv/bin/python -u -m etl.pipeline.incremental --apply ${OLAP_INCREMENTAL_ARGS}
TimeoutStartSec=infinity
UMask=0077
StandardOutput=journal
StandardError=journal
