<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>dim_calendar</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Complete calendar START_DATE..END_DATE, deduplicated source holidays, stable date key.</description>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>START_DATE</name>
        <default_value>2021-01-01</default_value>
        <description>Inclusive calendar bound, YYYY-MM-DD</description>
      </parameter>
      <parameter>
        <name>END_DATE</name>
        <default_value>2026-12-31</default_value>
        <description>Inclusive calendar bound, YYYY-MM-DD</description>
      </parameter>
    </parameters>
  </info>
  <order>
    <hop>
      <from>Bentuk kalender dan gabung libur</from>
      <to>Upsert dim_calendar</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Bentuk kalender dan gabung libur</name>
    <type>TableInput</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>presensi_source</connection>
    <sql>WITH bounds AS (
 SELECT '${START_DATE}'::date AS start_date, '${END_DATE}'::date AS end_date
), dates AS (
 SELECT b.start_date + n AS tanggal
 FROM bounds b
 CROSS JOIN LATERAL generate_series(0 + 1 / CASE WHEN b.end_date &gt;= b.start_date THEN 1 ELSE 0 END - 1,
 b.end_date - b.start_date) AS n
), holidays AS (
 SELECT tanggal, string_agg(DISTINCT keterangan, '; ' ORDER BY keterangan) AS keterangan_libur,
 array_to_string(array_agg(DISTINCT id ORDER BY id), ',') AS libur_id_sumber,
 max(created_at) AS libur_source_created_at_terakhir
 FROM public.m_hari_libur GROUP BY tanggal
)
SELECT d.tanggal,
 extract(year FROM d.tanggal)::integer AS tahun,
 extract(month FROM d.tanggal)::integer AS bulan,
 (ARRAY['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'])[extract(month FROM d.tanggal)::integer] AS nama_bulan,
 extract(day FROM d.tanggal)::integer AS hari,
 (ARRAY['Senin','Selasa','Rabu','Kamis','Jumat','Sabtu','Minggu'])[extract(isodow FROM d.tanggal)::integer] AS nama_hari,
 extract(week FROM d.tanggal)::integer AS minggu_ke,
 extract(quarter FROM d.tanggal)::integer AS kuartal,
 extract(isodow FROM d.tanggal)&gt;=6 AS is_weekend,
 h.tanggal IS NOT NULL AS is_hari_libur,
 h.keterangan_libur,
 extract(isodow FROM d.tanggal)::integer AS hari_iso,
 extract(isoyear FROM d.tanggal)::integer AS tahun_iso,
 extract(isodow FROM d.tanggal)&lt;=5 AS is_hari_kerja_normal,
 h.libur_id_sumber, h.libur_source_created_at_terakhir
FROM dates d LEFT JOIN holidays h ON h.tanggal=d.tanggal
ORDER BY d.tanggal
</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <GUI>
      <xloc>160</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Upsert dim_calendar</name>
    <type>InsertUpdate</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>presensi_target</connection>
    <commit>1000</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema>public</schema>
      <table>dim_calendar</table>
      <key>
        <name>tanggal</name>
        <field>tanggal</field>
        <condition>=</condition>
      </key>
      <value>
        <name>tanggal</name>
        <rename>tanggal</rename>
        <update>N</update>
      </value>
      <value>
        <name>tahun</name>
        <rename>tahun</rename>
        <update>Y</update>
      </value>
      <value>
        <name>bulan</name>
        <rename>bulan</rename>
        <update>Y</update>
      </value>
      <value>
        <name>nama_bulan</name>
        <rename>nama_bulan</rename>
        <update>Y</update>
      </value>
      <value>
        <name>hari</name>
        <rename>hari</rename>
        <update>Y</update>
      </value>
      <value>
        <name>nama_hari</name>
        <rename>nama_hari</rename>
        <update>Y</update>
      </value>
      <value>
        <name>minggu_ke</name>
        <rename>minggu_ke</rename>
        <update>Y</update>
      </value>
      <value>
        <name>kuartal</name>
        <rename>kuartal</rename>
        <update>Y</update>
      </value>
      <value>
        <name>is_weekend</name>
        <rename>is_weekend</rename>
        <update>Y</update>
      </value>
      <value>
        <name>is_hari_libur</name>
        <rename>is_hari_libur</rename>
        <update>Y</update>
      </value>
      <value>
        <name>keterangan_libur</name>
        <rename>keterangan_libur</rename>
        <update>Y</update>
      </value>
      <value>
        <name>hari_iso</name>
        <rename>hari_iso</rename>
        <update>Y</update>
      </value>
      <value>
        <name>tahun_iso</name>
        <rename>tahun_iso</rename>
        <update>Y</update>
      </value>
      <value>
        <name>is_hari_kerja_normal</name>
        <rename>is_hari_kerja_normal</rename>
        <update>Y</update>
      </value>
      <value>
        <name>libur_id_sumber</name>
        <rename>libur_id_sumber</rename>
        <update>Y</update>
      </value>
      <value>
        <name>libur_source_created_at_terakhir</name>
        <rename>libur_source_created_at_terakhir</rename>
        <update>Y</update>
      </value>
    </lookup>
    <GUI>
      <xloc>480</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>