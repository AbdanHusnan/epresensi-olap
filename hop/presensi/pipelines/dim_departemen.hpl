<?xml version='1.0' encoding='UTF-8'?>
<pipeline>
  <info>
    <name>dim_departemen</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Snapshot m_departemen -&gt; epresensi_analytics_hop_dev.public.dim_departemen</description>
    <pipeline_type>Normal</pipeline_type>
    <parameters />
  </info>
  <order>
    <hop>
      <from>Baca dan mapping departemen</from>
      <to>Upsert dim_departemen</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Baca dan mapping departemen</name>
    <type>TableInput</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>presensi_source</connection>
    <sql>SELECT id AS departemen_id, id AS departemen_id_sumber, kode AS kode_departemen, nama_departemen, kode_lengkap, parent AS parent_id_sumber, opd_parent AS opd_induk_id_sumber, unit_kerja_induk AS unit_kerja_induk_id_sumber FROM public.m_departemen ORDER BY id</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <GUI>
      <xloc>160</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Upsert dim_departemen</name>
    <type>InsertUpdate</type>
    <distribute>Y</distribute>
    <copies>1</copies>
    <connection>presensi_target</connection>
    <commit>1000</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema>public</schema>
      <table>dim_departemen</table>
      <key>
        <name>departemen_id_sumber</name>
        <field>departemen_id_sumber</field>
        <condition>=</condition>
      </key>
      <value>
        <name>departemen_id_sumber</name>
        <rename>departemen_id_sumber</rename>
        <update>N</update>
      </value>
      <value>
        <name>kode_departemen</name>
        <rename>kode_departemen</rename>
        <update>Y</update>
      </value>
      <value>
        <name>nama_departemen</name>
        <rename>nama_departemen</rename>
        <update>Y</update>
      </value>
      <value>
        <name>kode_lengkap</name>
        <rename>kode_lengkap</rename>
        <update>Y</update>
      </value>
      <value>
        <name>parent_id_sumber</name>
        <rename>parent_id_sumber</rename>
        <update>Y</update>
      </value>
      <value>
        <name>opd_induk_id_sumber</name>
        <rename>opd_induk_id_sumber</rename>
        <update>Y</update>
      </value>
      <value>
        <name>unit_kerja_induk_id_sumber</name>
        <rename>unit_kerja_induk_id_sumber</rename>
        <update>Y</update>
      </value>
      <value>
        <name>departemen_id</name>
        <rename>departemen_id</rename>
        <update>N</update>
      </value>
    </lookup>
    <GUI>
      <xloc>480</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling />
  <attributes />
</pipeline>